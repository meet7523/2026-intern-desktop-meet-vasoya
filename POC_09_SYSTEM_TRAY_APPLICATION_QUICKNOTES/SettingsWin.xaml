<Window x:Class="POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES.SettingsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"      
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES"
        mc:Ignorable="d"
        Title="Settings"
        Height="550"
        Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>


        <TextBlock Grid.Row="0"
                Grid.ColumnSpan="3"
                Text="Application Settings"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,10"/>


        <CheckBox Grid.Row="2"
               x:Name="chkStartWithWindows"
               Grid.ColumnSpan="3"
               Content="Start with Windows"
               FontSize="14"
               VerticalAlignment="Center"
               Checked="chkStartWithWindows_Checked"
               Unchecked="chkStartWithWindows_Unchecked">

        </CheckBox>


        <CheckBox Grid.Row="6"
                  Grid.Column="0"
                  x:Name="chkEnableNotifications"
                   Content="Enable Notifications"
                   FontSize="14"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="7"
                   Text="Opacity"
                    Grid.Column="3"
                   FontSize="14"
                    x:Name="txtOpacityValue"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="8"
                Grid.Column="0"
                Text="Window Opacity"
                FontSize="14"
                VerticalAlignment="Center"/>



        <Slider Grid.Row="8"
                x:Name="sliderOpacity"
             Grid.ColumnSpan="3"
             Margin="175,0,50,0"
             Minimum="30"
            Maximum="100"
            TickFrequency="5"
            IsSnapToTickEnabled="True"
             ValueChanged="Slider_ValueChanged"/>

        <TextBlock Grid.Row="10"
                Grid.Column="0"
                Text="Font Size"
                FontSize="14"
                VerticalAlignment="Center"/>

        <ComboBox Grid.Row="10"
                  x:Name="cmbFontSize"
               Grid.Column="1"
               Width="150"
               Height="30"
               HorizontalAlignment="Center">
            <ComboBoxItem Content="12"/>
            <ComboBoxItem Content="14"/>
            <ComboBoxItem Content="16"/>
            <ComboBoxItem Content="18"/>
            <ComboBoxItem Content="20"/>
        </ComboBox>

        <TextBlock Grid.Row="12"
                Grid.Column="0"
                Text="Theme"
                FontSize="14"
                VerticalAlignment="Center"/>

        <ComboBox Grid.Row="12"
                  x:Name="cmbTheme"
               Grid.Column="1"
               Width="150"
               Height="30"
               HorizontalAlignment="Center">
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
        </ComboBox>


        <StackPanel Grid.Row="13"
                 Grid.Column="1"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right" Margin="0,20,27,59" Grid.ColumnSpan="2" Width="188">

            <Button Content="Save"
                 Width="80"
                 Height="40"
                 Margin="0,0,15,0"
                 Click="Button_ClickSave"/>

            <Button Content="Cancel"
                 Width="80"
                 Height="40"
                 Click="Button_ClickCancel"/>
        </StackPanel>

    </Grid>
</Window>
