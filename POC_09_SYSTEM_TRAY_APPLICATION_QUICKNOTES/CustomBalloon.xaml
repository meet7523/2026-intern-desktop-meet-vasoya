<UserControl x:Class="POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES.CustomBalloon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES"
        mc:Ignorable="d"
        Height="100" Width="350"
        MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <Border Background="White"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">

        <StackPanel>

            <TextBlock Text="📝 Quick Notes"
                       FontWeight="Bold"
                       FontSize="16"/>

            <TextBlock Text="Click here to open the application."
                       Margin="0,5,0,0"
                       FontSize="15"/>

        </StackPanel>

    </Border>
</UserControl>
