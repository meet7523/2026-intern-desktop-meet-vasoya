<Window x:Class="POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        ShowInTaskbar="False"
        Topmost="True"
        Title="Quick Notes" Height="700" Width="1100">


    <Grid x:Name="Apptitle" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" Grid.Column="1">

            <Image Source="/Assets/app.ico"
                   Width="30"
                   Height="30"
                   Margin="10"/>

            <TextBlock Text="Quick Notes Application"
                       VerticalAlignment="Center"
                       FontSize="20"/>

        </StackPanel>



        <Grid Grid.Row="1" Margin="10,10,10,10" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="7.675"/>
                <ColumnDefinition Width="112.325"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"   
                 Grid.Column="0"
                 Height="30"
                 Margin="0,0,50,0"
                 VerticalContentAlignment="Center"
                 Padding="10,0"
                 FontSize="15"
                 TextChanged="txtSearch_TextChanged" Grid.ColumnSpan="2"/>

            <TextBlock x:Name="txtHint"
                       Text=" Search Notes.."
                       Foreground="Gray"
                       HorizontalAlignment="Left"    
                       VerticalAlignment="Center"
                       FontSize="15"/>



            <Button x:Name="btnbackup"
                     Grid.Column="1"
                     Content="Backup File"
                     Height="30"
                     FontSize="15" Click="btnbackup_Click" Grid.ColumnSpan="3" Margin="90,0,10,0"/>
        </Grid>



        <ListBox Grid.Row="2"
                 x:Name="notesListBox"
                 Margin="10,19,10,1"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 Height="200" Grid.ColumnSpan="2" Background="#FFCFC6C6">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            Width="985"
                            Margin="5"
                            Padding="8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock  Text="ID: " 
                                            FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                    <TextBlock  Text="{Binding Id}" 
                                            FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                </StackPanel>


                                <StackPanel Orientation="Horizontal">

                                    <TextBlock  Text="Title: " 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                    <TextBlock Text="{Binding Title}" 
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                </StackPanel>


                                <StackPanel Orientation="Horizontal">

                                    <TextBlock  Text="Tag: " 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                    <TextBlock Text="{Binding Notetag}" 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                </StackPanel>


                                <StackPanel Orientation="Horizontal">

                                    <TextBlock  Text="Notes: " 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                    <TextBlock Text="{Binding Notemsg}" 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                </StackPanel>


                                <StackPanel Orientation="Horizontal" >

                                    <TextBlock  Text="CreateDate: " 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                    <TextBlock Text="{Binding CreateDate}" 
                                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                                </StackPanel>

                            </StackPanel>

                            <StackPanel Grid.Column="1">


                                <TextBlock Text="⭐" FontSize="30" Foreground="Black" Margin="0 30 0 0 ">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>
        </ListBox>





        <Grid Grid.Row="2" Margin="10,257,10,-222" Grid.ColumnSpan="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnadd"
            Grid.Row="0"
            Grid.Column="0"
            Content="Add Notes"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnadd_Click"/>

            <Button x:Name="btnview"
            Grid.Row="0"
            Grid.Column="1"
            Content="View Notes"                                    
            Height="40"
            Margin="10"
            FontSize="15" Click="btnview_Click"/>

            <Button x:Name="btnedit"
            Grid.Row="0"
            Grid.Column="2"
            Content="Update Notes"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnedit_Click"/>

            <Button x:Name="btndelete"
            Grid.Row="1"
            Grid.Column="0"
            Content="Delete Notes"
            Height="40"
            Margin="10"
            FontSize="15" Click="btndelete_Click"/>

            <Button x:Name="btnsortbydate"
            Grid.Row="1"
            Grid.Column="1"
            Content="Sort By Date"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnsortbydate_Click"/>

            <Button x:Name="btnsortbytitle"
            Grid.Row="1"
            Grid.Column="2"
            Content="Sort By Title"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnsortbytitle_Click"/>

            <Button x:Name="btntagnotes"
            Grid.Row="2"
            Grid.Column="0"
            Content="Tag Notes"
            Height="40"
            Margin="10"
            FontSize="15" Click="btntagnotes_Click"/>

            <Button x:Name="btnsearchbycontent"
            Grid.Row="2"
            Grid.Column="1"
            Content="Search By Content"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnsearchbycontent_Click"/>

            <Button x:Name="btnfavoritenotes"
            Grid.Row="2"
            Grid.Column="2"
            Content="Favorite Notes"
            Height="40"
            Margin="10"
            FontSize="15" Click="btnfavoritenotes_Click"/>

        </Grid>

    </Grid>
</Window>   



