<Window x:Class="POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES.QuickNotes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="QuickNotes" 
        Height="450" Width="600"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">



    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="27*"/>
        </Grid.RowDefinitions>

        <Label
            Grid.Column="0"
            Content="Quick Notes"
            Width="100"
            FontSize="15" Margin="18,-1,462,107"/>

        <TextBlock x:Name="notestitle"
                   Text="Notes Title"
                   FontSize="15"
                   Margin="27,38,460,103"/>

        <TextBox x:Name="txttitle"
                 FontSize="13"
                 Height="25" Margin="27,63,33,73"
                 TextChanged="titlebox_TextChanged"/>

        <TextBlock x:Name="txtHint"
               Text=" Enter Title"
               Foreground="Gray"
               HorizontalAlignment="Left"    
               VerticalAlignment="Top"
               FontSize="15" Margin="32,64,0,0"/>



        <TextBlock x:Name="notestag"
                   Text="Notes Tag"
                   FontSize="15"
                   Margin="27,101,460,40"/>

        <TextBox x:Name="txttag"
                 FontSize="13"
                 Height="25" Margin="25,126,35,10"
                 TextChanged="txttag_TextChanged"/>
        
       
        <TextBlock x:Name="txttaghint"
               Text=" Enter Tag"
               Foreground="Gray"
               HorizontalAlignment="Left"    
               VerticalAlignment="Top"
               FontSize="15" Margin="32,126,0,0"/>

      


        <TextBox
                x:Name="txtNote"
                AcceptsReturn="True"
                BorderThickness="1"
                TextWrapping="Wrap"
                Margin="25,10,35,136"
                VerticalScrollBarVisibility="Auto"              
                FontSize="14" Text="" Grid.Row="1"
                TextChanged="txtNote_TextChanged"/>

        <TextBlock x:Name="txtnote"
                 Text=" Enter Note"
                 Foreground="Gray"
                 HorizontalAlignment="Left"    
                 VerticalAlignment="Top"
                 FontSize="15" Margin="36,26,0,0" Grid.Row="1"/>

        <TextBlock x:Name="savenote"
                   Text="Press Ctrl + Enter --> Save"
                   FontSize="14" Margin="32,0,336,70" Grid.Row="1" Height="27" VerticalAlignment="Bottom"/>

        <TextBlock x:Name="cancelnote"
                   Text="Press Esc --> Cancel"
                   FontSize="14" Margin="32,0,383,38" Grid.Row="1" Height="27" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
