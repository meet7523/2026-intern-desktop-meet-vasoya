<Application x:Class="POC_09_SYSTEM_TRAY_APPLICATION___QUICK_NOTES.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="MainWindow.xaml">


    <Application.Resources>
        <ContextMenu x:Key="TrayMenu">

            <MenuItem Header="⚡ Open Notes" Click="MenuItem_Click1"/>

            <Separator/>

            <MenuItem Header="➕ New Quick Note" Click="MenuItem_Click2"/>

            <Separator/>

            <MenuItem Header="⭐ View Favorites" Click="MenuItem_Click3"/>

            <Separator/>

            <MenuItem Header="🔍 Search Notes" Click="MenuItem_Click4"/>

            <Separator/>

            <MenuItem Header="⚙️ Settings" Click="MenuItem_Click5"/>

            <Separator/>

            <MenuItem Header="❌ Exit" Click="MenuItem_Click6"/>

        </ContextMenu>

        <tb:TaskbarIcon
         x:Key="TrayIcon"
         IconSource="/Assets/app.ico"
         ToolTipText="Quick Notes - Click to" 
         ContextMenu="{StaticResource TrayMenu}"
         TrayLeftMouseUp="TaskbarIcon_TrayLeftMouseUp">
        </tb:TaskbarIcon>

    </Application.Resources>
</Application>
