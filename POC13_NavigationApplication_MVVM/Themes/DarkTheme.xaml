<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


 
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="White"/>


    <SolidColorBrush x:Key="WindowBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#3F3F46"/>


    <SolidColorBrush x:Key="BorderBrush" Color="#5A5A5A"/>


    <SolidColorBrush x:Key="GridBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="GridForeground" Color="White"/>
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#3F3F46"/>
    <SolidColorBrush x:Key="GridHeaderForeground" Color="White"/>




</ResourceDictionary>