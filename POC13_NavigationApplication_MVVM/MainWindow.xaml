
    <Window x:Class="POC13_NavigationApplication_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC13_NavigationApplication_MVVM"
        xmlns:vm="clr-namespace:POC13_NavigationApplication_MVVM.ViewModels"
        xmlns:view="clr-namespace:POC13_NavigationApplication_MVVM.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="600" Width="1200" MinWidth="500">


    <Window.Resources>

        <Style x:Key="NoHoverMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                            ContentSource="Header"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <view:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <view:ProductsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <view:SettingsView/>
        </DataTemplate>

    </Window.Resources>

    <Grid  Margin="10" x:Name="first" Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="App"
                   Text="Navigation Application"
                   FontSize="20"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 10"
                   Foreground="{DynamicResource AppForegroundBrush}"/>


        <Grid Grid.Row="1" x:Name="second">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                <Menu x:Name="Navigation"
                      MinHeight="30"
                      MinWidth="1515">

                    <MenuItem Header="Home"
                    Margin="10 0 10 0"
                    Style="{StaticResource NoHoverMenuItemStyle}"
                    FontSize="15"
                    Padding="5 2 0 0"
                    Command= "{Binding HomeCommand}"/>

                    <MenuItem Header="Products"
                      Margin="10 0 10 0"
                      Style="{StaticResource NoHoverMenuItemStyle}"
                      FontSize="15"
                      Padding="5 2 0 0"
                      Command= "{Binding ProductsCommand}"/>

                    <MenuItem Header="Settings"
                  Margin="10 0 10 0"
                  Style="{StaticResource NoHoverMenuItemStyle}"
                  FontSize="15"
                  Padding="5 2 0 0"
                  Command="{Binding SettingsCommand}"/>

                </Menu>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="2" Margin="10"
              x:Name="Third">

            <Border x:Name="maincontent">


                <ContentControl x:Name="contentnavigation"
                            Height="490"
                            Width="1160"
                            Content="{Binding CurrentViewModel}"
                            Foreground="{DynamicResource AppForegroundBrush}"/>
            </Border>

        </Grid>
    </Grid>


</Window>
