<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="AppBackground" Color="#252526"/>
    <SolidColorBrush x:Key="AppForeground" Color="White"/>

    <SolidColorBrush x:Key="CardBackground" Color="#333333"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#555"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#0E639C"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

    <SolidColorBrush x:Key="GridBackground" Color="#252526"/>
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#3F3F46"/>
    <SolidColorBrush x:Key="GridHeaderForeground" Color="White"/>
    <SolidColorBrush x:Key="GridRowBackground" Color="#252526"/>
    <SolidColorBrush x:Key="GridRowForeground" Color="White"/>

    <System:Double x:Key="AppFontSize">14</System:Double>




</ResourceDictionary>