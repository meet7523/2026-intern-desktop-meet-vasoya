<UserControl x:Class="POC15__TaskManagementApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POC15__TaskManagementApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Background="{DynamicResource AppBackground}">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
		
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Application Dashboard"
                   FontSize="18"
				   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppForeground}"/>

		<UniformGrid Grid.Row="1"
                     Columns="2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
					 Margin="0 60 0 0">


			<Border BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="2"
                    CornerRadius="5"
					Width="250"
                    Height="200"
					Margin="10"
                    Padding="15">

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="Total Tasks"
                               FontWeight="SemiBold"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>

					<TextBlock Text="{Binding TotalTasks}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppForeground}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

				</StackPanel>

			
			</Border>
			</UniformGrid>

		<StackPanel Grid.Row="1"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,15,10,0">

			<TextBlock Text="⚠ Total Overdue Task :"
					   FontWeight="SemiBold"
					   FontSize="18"
				       Foreground="Red"
					   VerticalAlignment="Center"/>

			<TextBlock Text="{Binding OverdueTasks}"
					   FontSize="18"
					   FontWeight="Bold"
					   Margin="10,0,0,0"
				       Foreground="Red"
					   VerticalAlignment="Center"/>

		</StackPanel>

		

		<UniformGrid Grid.Row="2"
                     Columns="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">

			<Border BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="2"
                    CornerRadius="5"
					Width="250"
                    Height="200"
					Margin="10"
                    Padding="15">

				<StackPanel HorizontalAlignment="Center"  VerticalAlignment="Center">
					<TextBlock Text="Complete Tasks"
                               FontWeight="SemiBold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>

					<TextBlock Text="{Binding CompletedTasks}"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>
				</StackPanel>

			</Border>
		


            <Border BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="2"
                    CornerRadius="5"
					Width="250"
                    Height="200"
					Margin="10"
                    Padding="15">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Incomplete Tasks"
                               FontWeight="SemiBold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>

                    <TextBlock Text="{Binding IncompleteTasks}"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

            </Border>

        </UniformGrid>

        
    </Grid>
</UserControl>
