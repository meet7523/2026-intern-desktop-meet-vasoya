<UserControl x:Class="POC15__TaskManagementApp.Views.EditTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POC15__TaskManagementApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800" Background="{DynamicResource AppBackground}">
    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0"
           Margin="0 20 0 0"
           Text=" Edit Task"
           Foreground="{DynamicResource AppForeground}"
           FontSize="18"
           FontWeight="Medium"
           HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
           Text="Task Title :"
           FontSize="14"
           Margin="10 10 20 0"
           FontWeight="Medium"
           Foreground="{DynamicResource AppForeground}"
           VerticalAlignment="Center"/>

        <TextBox Grid.Row="2"
         Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"
         Height="30"
         Margin="10 10 20 0"
         FontSize="14"
         Padding="5 5 0 0"/>

        <TextBlock Grid.Row="3"
        Text="{Binding TitleError}"
        Margin="10 5 0 0"
        Foreground="Red"
        FontSize="15"
        FontWeight="Normal"/>

        <TextBlock Grid.Row="4"
           Text="Description :"
           VerticalAlignment="Top"
           FontSize="14"
           Foreground="{DynamicResource AppForeground}"
           FontWeight="Medium"
           Margin="10,10,20,0"/>

        <TextBox Grid.Row="5"
         Margin="10 10 20 0"
         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
         Height="100"
         AcceptsReturn="True"
         TextWrapping="Wrap"
         FontSize="14"
         Padding="5 5 0 0"/>


        <TextBlock Grid.Row="6"
        Text="{Binding  DescriptionError}"
        Margin="10 5 0 0"
        Foreground="Red"
        FontSize="15"
        FontWeight="Normal"/>

        <TextBlock Grid.Row="7"
           Text="Due Date :"
           FontSize="14"
           Foreground="{DynamicResource AppForeground}"
           FontWeight="Medium"
           Margin="10 10 0 0"/>

        <local:CalendarView
        Grid.Row="8"
        HorizontalAlignment="Stretch"
        Margin="10 7 20 5"
        DataContext="{Binding Calendar}"/>  

        <TextBlock Grid.Row="9"
        Text="{Binding DueDateError}"
        Margin="10 5 0 0"
        Foreground="Red"
        FontSize="15"
        FontWeight="Normal"/>

        <TextBlock Grid.Row="10"
       Text="Priority :"
       VerticalAlignment="Center"
       Margin="10,10,0,0"
       FontSize="14"
       Foreground="{DynamicResource AppForeground}"
       FontWeight="Medium"/>

        <ComboBox Grid.Row="11"
          Width="150"
		  Height="30"
		  FontSize="15"
          Margin="10,10,0,0"
		  Padding="50 5 0 0"
          HorizontalAlignment="Left"
          ItemsSource="{Binding Priorities}"
          SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


        <TextBlock Grid.Row="12"
        Text="{Binding PriorityError}"
        Margin="5 0 0 0"
        Foreground="Red"
        FontSize="15"
        FontWeight="Normal"/>

        <TextBlock Grid.Row="13"
       Text="Completed :"
       VerticalAlignment="Center"
       Margin="10,10,0,0"
       FontSize="14"
       Foreground="{DynamicResource AppForeground}"
       FontWeight="Medium"/>

        <CheckBox Grid.Row="14"
          Content="Mark as Completed"
          Height="25"
          Foreground="{DynamicResource AppForeground}"
          Margin="10 10 0 0"
          IsChecked="{Binding IsCompleted, Mode=TwoWay}">

            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </CheckBox.LayoutTransform>

        </CheckBox>

        <StackPanel Grid.Row="15"
        Grid.ColumnSpan="2"
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        Margin="0,20,0,0">


            <Button Content="Update Task"
                    x:Name="btnSave"
                    Width="100"
                    Height="35"
                    Margin="0 0 23 0"
                    FontSize="15"
                    FontWeight="Normal"
                    Background="#007ACC"
                    Foreground="White"
                    Command="{Binding UpdateTaskCommand}"/>

        </StackPanel>



    </Grid>
</UserControl>
