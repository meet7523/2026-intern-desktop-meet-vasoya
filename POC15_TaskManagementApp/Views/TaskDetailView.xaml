<UserControl x:Class="POC15__TaskManagementApp.Views.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POC15__TaskManagementApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800" Background="{DynamicResource AppBackground}">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <TextBlock Text="Task Details"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Medium"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource AppForeground}"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1"
             Background="{DynamicResource AppBackground}"
             BorderBrush="{DynamicResource BorderBrushColor}"
             BorderThickness="1"
             CornerRadius="8"
             Padding="5"
             Margin="0,0,0,10">

            <WrapPanel ItemHeight="65"
            VerticalAlignment="Center">


                <StackPanel Width="180"
                 Margin="5">
                    <TextBlock Text="Status"
					HorizontalAlignment="Center"
					FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox 
					HorizontalAlignment="Center"
					Width="150"
		            Height="30"
		            FontSize="15"
                    Margin="5,0,0,0"
		            Padding="40 5 0 0"
                   ItemsSource="{Binding StatusFilters}"
                   SelectedItem="{Binding SelectedStatus,Mode=TwoWay}"
                   FontWeight="Normal"/>
                </StackPanel>

                <StackPanel Width="180"
                 Margin="5">
                    <TextBlock Text="Priority"
					HorizontalAlignment="Center"
                    FontWeight="SemiBold"
					FontSize="15"
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox 
					HorizontalAlignment="Center"
					Width="150"
		            Height="30"
		            FontSize="15"
                    Margin="5,0,0,0"
		            Padding="40 5 0 0"
                   ItemsSource="{Binding PriorityFilters}"
                   SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                   FontWeight="Normal"/>
                </StackPanel>

                <StackPanel Width="180"
                 Margin="5">
                    <TextBlock Text="Due Date"
					HorizontalAlignment="Center"
					FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox 
					HorizontalAlignment="Center"
                   ItemsSource="{Binding DueDateFilters}"
                   SelectedItem="{Binding SelectedDueDate, Mode=TwoWay}"
				   Width="150"
		           Height="30"
		           FontSize="15"
                   Margin="5,0,0,0"
		           Padding="40 5 0 0"
                   FontWeight="Normal"/>
                </StackPanel>


                <StackPanel VerticalAlignment="Center">
                    <Button Content="Reset Filters"
                     Width="110"
                     Margin="20 22 0 0"
                     Height="31"
					 Background="#007ACC"
                     Foreground="White"
                     FontSize="15"
                     Command="{Binding ResetFilterCommand}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Margin="200 10 0 0">


                    <TextBlock Text="Search Task :"
                               Height="30"
							   Padding="5 6 0 0"
                               Width="90"
                               FontSize="15"
                               Foreground="{DynamicResource AppForeground}"
                               FontWeight="Medium"/>



                    <TextBox Width="250"
                     Height="28"
					 Margin="5 6 0 4"
                     Padding="5 0 0 0"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" />

                    

                </StackPanel>

            </WrapPanel>

        </Border>


        <StackPanel Grid.Row="2" Orientation="Horizontal"
            Margin="10">

            <TextBlock Text="Task Sort By:"
               VerticalAlignment="Center"
               Margin="0,0,8,0"
			   FontWeight="SemiBold"
               FontSize="15"
               Foreground="{DynamicResource AppForeground}"/>

            <ComboBox 
			  HorizontalAlignment="Center"
              ItemsSource="{Binding SortOption}"
              SelectedItem="{Binding SelectedSortOption,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			  Width="190"
		      Height="30"
		      FontSize="15"
              Margin="5,0,0,0"
		      Padding="40 5 0 0"
              />

        </StackPanel>




        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredTasks}"
                  SelectedItem="{Binding SelectedTask,Mode=TwoWay}"
                  Margin="0 10 0 0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  FontSize="{DynamicResource AppFontSize}">

            <DataGrid.RowStyle>

                <Style TargetType="DataGridRow">

                    <Setter Property="Background"
                    Value="{Binding Priority,
                    Converter={StaticResource PriorityBackgroundConverter}}"/>

                </Style>

            </DataGrid.RowStyle>



            <DataGrid.Resources>

                <Style x:Key="GridTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize"
                Value="{DynamicResource AppFontSize}"/>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ShortId}"
                                    Width="150"
                                    FontWeight="Normal"
                                     ElementStyle="{StaticResource GridTextStyle}" />

                <DataGridTextColumn Header="Title"
                                    Binding="{Binding Title}"
                                    Width="200"
                                    FontWeight="Normal"
                                     ElementStyle="{StaticResource GridTextStyle}" />

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="300"
                                    FontWeight="Normal"
                                     ElementStyle="{StaticResource GridTextStyle}" />

                <DataGridTextColumn Header="Due Date"
                                    Binding="{Binding DueDate,StringFormat=dd-MMM-yyyy}"
                                    Width="200"
                                    FontWeight="Normal"
                                     ElementStyle="{StaticResource GridTextStyle}" />

                <DataGridTextColumn Header="Priority"
                                    Binding="{Binding Priority}"
                                    Width="200" 
                                    FontWeight="Normal"
                                     ElementStyle="{StaticResource GridTextStyle}" />

                <DataGridTemplateColumn Header="Status" Width="150">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                                <CheckBox x:Name="chkStatus"
                          IsChecked="{Binding IsCompleted,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                          />



                                <StackPanel x:Name="spOverdue"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">

                                             <TextBlock Text="⚠"
                                               Foreground="black"
                                               FontWeight="Bold"
                                               Margin="5,0,3,0"/>

                                         <TextBlock Text="Overdue"
                                               Foreground="Black"
                                               FontWeight="Bold"
                                               />  

                                </StackPanel>



                            </StackPanel>

                            <DataTemplate.Triggers>

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsCompleted}"
                                                   Value="False"/>

                                        <Condition Binding="{Binding IsOverdue}"
                                                   Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="spOverdue"
                                            Property="Visibility"
                                            Value="Visible"/>   

                                </MultiDataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Complete Date"
                                    Binding="{Binding CompletedDate,StringFormat=dd-MMM-yyyy HH:mm}"
                                    Width="250"
                                    ElementStyle="{StaticResource GridTextStyle}"
                                    FontWeight="Normal"/>   

            </DataGrid.Columns>

        </DataGrid>

        <TextBlock
         Text="{Binding NoDataMessage}"
         Grid.Row="4"
         FontSize="14"
         FontWeight="Medium"
         Foreground="{DynamicResource AppForeground}"
         HorizontalAlignment="Left"
         VerticalAlignment="Center"
         Panel.ZIndex="1"/>


        <StackPanel Grid.Row="4"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">


            <Button Content="Edit Task"
            x:Name="btnEdit"
            Width="100"
            Height="35"
            Margin="5"
            FontSize="15"
            FontWeight="Normal"
            Background="#007ACC"
            Foreground="White"
            Command="{Binding EditTaskCommand }"/>

            <Button Content="Delete Task"
                x:Name="btnDelete"
                Width="100"
                Height="35"
                Margin="5"
                FontSize="15"
                FontWeight="Normal"
                Command="{Binding DeleteTaskCommand}"
                Background="#007ACC"
                Foreground="White"/>


            <Button Content="Export To File"
                    x:Name="btnExport"
                    Width="100"
                    Height="35"
                    Margin="5"
                    FontSize="15"
                    FontWeight="Normal"
                    Background="#007ACC"
                    Foreground="White"
                    Command="{Binding ExportTasksCommand}"/>

            <Button Content="Back"
                    x:Name="btnBack"
                    Width="100"
                    Height="35"
                    Margin="5"
                    FontSize="15"
                    FontWeight="Normal"
                    Background="#007ACC"
                    Foreground="White"
                    Command="{Binding BackCommand}"/>  



        </StackPanel>


    </Grid>
</UserControl>
