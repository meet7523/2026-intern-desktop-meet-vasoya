<Window x:Class="POC15__TaskManagementApp.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC15__TaskManagementApp.Views"
        mc:Ignorable="d"
        Title="Due Date Notifications"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{DynamicResource AppBackground}"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380"
        Height="180">
    
    <Grid>

        <Border CornerRadius="10"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource BorderBrushColor}"
            BorderThickness="1">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <DockPanel Grid.Row="0">

                    <TextBlock Text="🔔"
                           FontSize="18"
                           Margin="0,0,5,0"
                           Foreground="{DynamicResource AppForeground}"/>


                    <TextBlock Text="Due Date Notification"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="{DynamicResource AppForeground}"/>

                    <Button x:Name="btnClose"
                        Content="✖"
                        Width="25"
                        Height="25"
						HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
						Foreground="{DynamicResource AppForeground}"
                        Click="btnClose_Click"/>
                </DockPanel>


                <TextBlock Grid.Row="1"
                       x:Name="txtMessage"
                       Margin="5"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{DynamicResource AppForeground}"/>


            </Grid>

        </Border>


    </Grid>
</Window>
