<Window x:Class="POC10_ProductInventoryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC10_ProductInventoryManagement"
        mc:Ignorable="d"
        Title="Product Inventory Management" Height="700" Width="800">



    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>



        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="182,-7,118,6">
            <TextBlock 
             x:Name="Appname"
             Text="Product Inventory Management"
             FontSize="16"
             FontWeight="DemiBold"/>

        </StackPanel>



        <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Product Id :"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="5,0,5,0"/>

        <TextBox Grid.Row="1"
                     Grid.Column="1"
                     
                     Margin="5,5,5,5"
                     Height="30"
                     Name="txtId"
                     Text="{Binding SelectedProduct.Id, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Product Name :"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="5,0,5,0"/>

        <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="5,5,5,5"
                     Height="30"
                     Name="txtName"
                     Text="{Binding SelectedProduct.Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Product Price :"
                       FontSize="16"
                       VerticalAlignment="Center"                                                          
                       Margin="5,0,5,0" Grid.ColumnSpan="3"/>

        <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Margin="5,5,5,5"
                     Height="30"                        
                     Name="txtPrice"
                     Text="{Binding SelectedProduct.Price, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Product Quantity:"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="5,0,5,0" Grid.ColumnSpan="3"/>

        <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Margin="5,5,5,5"
                     Height="30"
                     Name="txtQuantity"
                     Text="{Binding SelectedProduct.Quantity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock 
                Text=" Total Product Value:"
                FontSize="16"
                VerticalAlignment="Top"
                Grid.ColumnSpan="2" Margin="0,7,4,5" Grid.Row="5"/>

        <TextBlock x:Name="txtTotalValue"
                    Text="{Binding ProductsTotal,UpdateSourceTrigger=PropertyChanged}"
                    FontSize="16"
                    VerticalAlignment="Top" Margin="150,10,55,0" Grid.Row="5"/>

        <Button Grid.Row="5"
                FontSize="16"
                Content="Add Product"
                Margin="90,90,102,140"
                Height="30"
                Click="Button_ClickSave"/>

        <Button Grid.Row="5"
                FontSize="16"
                Content="Clear Product"
                Margin="257,90,234,140"
                Height="30"
                Click="Button_ClickClear" Grid.ColumnSpan="2"/>




        <DataGrid Grid.Row="5"
                  Height="100"
                  Margin="48,130,48,-120"
                  Name="dataGridProducts"
                  FontSize="16"
                  ItemsSource="{Binding Products}"
                  AutoGenerateColumns="False" Grid.ColumnSpan="2"
                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="Total" IsReadOnly="True" Binding="{Binding Total}" Width="100" />
            </DataGrid.Columns>

        </DataGrid>

        <Button Grid.Row="5"
        Content="Remove Product"
        FontSize="16"
        Margin="109,90,71,140"
        Height="30"
        Click="Button_ClickRemove" Grid.Column="1"/>



    </Grid>
</Window>
