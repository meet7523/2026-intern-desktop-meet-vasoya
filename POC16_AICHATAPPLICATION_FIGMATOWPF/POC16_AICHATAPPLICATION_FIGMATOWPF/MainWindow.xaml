<Window x:Class="POC16_AICHATAPPLICATION_FIGMATOWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF"
        xmlns:viewModels="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.ViewModels"
        xmlns:views="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Views"
        xmlns:helpers="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Converters"
        xmlns:converters="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Converters"
        xmlns:behaviors="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Behaviors"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="AI Chat Application"
        Height="800" 
        Width="1440"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="{StaticResource WindowBackground}"
        Icon="/Assets/app-icon.ico">


    <Window.Resources>

        <helpers:BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>


        <converters:PlaceholderVisibilityConverter
            x:Key="PlaceholderVisibilityConverter"/>


        <DataTemplate DataType="{x:Type viewModels:AiChatViewModel}">
            <views:AiChatView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>






    </Window.Resources>

    <Grid>

        <Grid x:Name="HomeScreen"
          Visibility="{Binding IsHomeScreenVisible,
                               Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="355"
                                  MinWidth="240"
                                  MaxWidth="360"/>

                <!-- Main Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0 : Sidebar -->
            <Border Grid.Column="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="0,0,1,0">

                <Grid>

                    <Border x:Name="chatbdr"
                            Height="28"
                            Margin="18,18,18,0"
                            HorizontalAlignment="Stretch"
                            Padding="0 2 0 2"
                            BorderBrush="{StaticResource BorderColor}"
                            VerticalAlignment="Top">    


                        <Grid>

                            <Image x:Name="chatimg"
                            Source="{svgc:SvgImage Source=/Assets/Images/ChatAi.svg}"
                            Width="30"
                            Height="24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>

                            <TextBlock x:Name="chattext"
                               Text="ChatAI"
                               Width="67"
                               Padding="0 3"
                               Height="27"
                               Margin="38,0,0,0"
                               FontFamily="Iner"
                               FontWeight="SemiBold"
                               FontSize="20"
                               LineHeight="20"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource TextPrimary}"/>

                        </Grid>

                    </Border>




                    <Button x:Name="NewChatbtn"
                        Height="48"
                        Margin="16,68,16,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="#4F46E5"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Command="{Binding FirstNewChatCommand}"
                        Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">

                                    <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>


                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <Image x:Name="Pluseicon"
                               Source="{svgc:SvgImage Source=/Assets/Images/Pluseicon.svg}"
                               Width="14"
                               Height="16"
                               HorizontalAlignment="Center"/>

                            <TextBlock Text="New Chat"
                                       Width="76"
                                       Height="20"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="White"
                                       LineHeight="100"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="5 0 4 0"/>

                        </StackPanel>

                    </Button>



                    <Border Height="1"
                            Background="{StaticResource BorderColor}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Margin="18,140,18,0"/>


                    <StackPanel Grid.Row="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="16">

                        <Image x:Name="Chaticon"
                           Source="{svgc:SvgImage Source=/Assets/Images/EmptyChat.svg}"
                           Width="45"
                           Height="36"
                           HorizontalAlignment="Center"/>





                        <TextBlock Text="No chats yet. Start a new conversation!"
                                MaxWidth="298"
                                Height="20"
                                FontFamily="Inter"
                                FontWeight="Normal"
                                LineHeight="16"
                                FontSize="16"
                                Foreground="#8D95A3"
                                HorizontalAlignment="Center"
                                Padding="10 0"/>

                    </StackPanel>

                </Grid>

            </Border>




            <Grid Grid.Column="1"  
                  Background="{StaticResource SidebarBackground}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="0 0 0 1"
                         Background="{StaticResource SidebarBackground}"
                         behaviors:WindowDragBehavior.EnableDrag="True">



                    <Grid>

                        <TextBlock  Text=""
                                    Width="400"
                                    Height="21"
                                    FontSize="16"
                                    FontFamily="Inter"
                                    LineHeight="18"
                                    FontWeight="Medium"
                                    TextAlignment="Left"
                                    Margin="16 5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Foreground="#1F2937"/>


                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Panel.ZIndex="1000"
                                IsHitTestVisible="True">

                            <!-- Minimize -->
                            <Button Content="−"
                                    Width="32"
                                    Height="32"
                                    FontSize="20"
                                    Foreground="{StaticResource TextPrimary}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Panel.ZIndex="1001"
                                    IsHitTestVisible="True"
                                    Command="{Binding MinimizeWindowCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                             CornerRadius="4">

                                            <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>


                            <!-- Close -->
                            <Button Content="×"
                                Width="32"
                                Height="32"
                                FontSize="20"
                                Foreground="{StaticResource TextPrimary}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Focusable="False"
                                Panel.ZIndex="1001"
                                IsHitTestVisible="True"
                                Command="{Binding CloseWindowCommand}">


                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">

                                            <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>




                <Border Grid.Row="1"
                        Margin="100 80 100 100">


                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Orientation="Vertical">


                        <Image Source="{svgc:SvgImage Source=/Assets/Images/Chatbot.svg}"
                        Width="75"
                        Height="60"
                        Stretch="Fill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"/>

                        <TextBlock Text="How can I help you today?"
                               Width="379"
                               Height="36"
                               FontFamily="Inter"
                               FontSize="30"
                               LineHeight="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Padding="9 0 0 0"
                               HorizontalAlignment="Center"/>


                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0">


                            <Border
                            x:Name="ChatBox1"
                             Width="246"
                             Height="58"
                             BorderBrush="{StaticResource BorderColor}"
                             BorderThickness="1"
                             CornerRadius="8"
                             HorizontalAlignment="Left"
                             Margin="0 0 0 0">

                                <Border x:Name="Innerbde1"
                                    Width="210"
                                    Height="20">

                               <TextBlock Text="Explain quantum computing"
                                Width="210"
                                Height="20"
                                FontFamily="Inter"
                                FontSize="16"
                                LineHeight="100"
                                FontWeight="Normal"
                                Foreground="{StaticResource TextPrimary}"
                                Padding="0 2 0 0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                </Border>
                            </Border>


                            <Border 
                                 x:Name="ChatBox2"
                                  Width="246"
                                  Height="58"
                                  BorderBrush="{StaticResource BorderColor}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  HorizontalAlignment="Left"
                                  Margin="16 0 0 0">

                                <TextBlock Text="Write a poem about AI"
                                         Width="210"
                                         Height="20"
                                         FontFamily="Inter"
                                         FontSize="16"
                                         LineHeight="100"
                                         FontWeight="Normal"
                                         Foreground="{StaticResource TextPrimary}"
                                         Padding="25 2 0 0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>


                            </Border>

                        </StackPanel>


                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0">


                            <Border 
                             x:Name="ChatBox3"
                              Width="246"
                              Height="58"
                              BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1"
                              CornerRadius="8"
                              HorizontalAlignment="Left"
                              Margin="0 0 0 0">

                                <TextBlock Text="Generate a story plot"
                                        Width="210"
                                        Height="20"
                                        FontFamily="Inter"
                                        FontSize="16"
                                        LineHeight="100"
                                        FontWeight="Normal"
                                        Foreground="{StaticResource TextPrimary}"
                                        Padding="30 2 0 0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>


                            </Border>


                            <Border 
                             x:Name="ChatBox4"
                              Width="246"
                              Height="58"
                              BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1"
                              CornerRadius="8"
                              HorizontalAlignment="Left"
                              Margin="16 0 0 0">

                                <TextBlock Text="Solve a math problem"
                                        Width="210"
                                        Height="20"
                                        FontFamily="Inter"
                                        FontSize="16"
                                        LineHeight="100"
                                        FontWeight="Normal"
                                        Foreground="{StaticResource TextPrimary}"
                                        Padding="30 2 0 0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>


                            </Border>


                        </StackPanel>

                    </StackPanel>

                </Border>




                <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0 1 0 0">

                    <Grid>

                        <Border 
                                Height="43"
                                Margin="24,0"
                                HorizontalAlignment="Stretch"
                                MaxWidth="896"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{StaticResource SidebarBackground}">

                            <Grid>


                                <TextBox x:Name="MessageTextBox"
                                      Text="{Binding MessageText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{StaticResource TextPrimary}"
                                       Height="43"
                                       MaxHeight="120"
                                       BorderThickness="0"
                                       FontFamily="Inter"
                                       Background="{StaticResource SidebarBackground}"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Padding="10 10 0 0"
                                       Margin="16,0,50,0"
                                       VerticalAlignment="Top"
                                       AcceptsReturn="True"
                                       AcceptsTab="True"
                                       TextWrapping="Wrap"
                                       behaviors:EnterToSendBehavior.Command="{Binding SendMessageCommand}"/>


                                <TextBlock Text="Type a message..."
                                           Margin="18,0,55,0"
                                           Padding="9 0"
                                           FontSize="17"
                                           FontFamily="Inter"
                                           FontWeight="Normal"
                                           Foreground="#A9AFBD"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                            Value="Visible"/>

                                            <Style.Triggers>

                                                <!-- Hide hint when TextBox gets focus -->
                                                <DataTrigger Binding="{Binding ElementName=MessageTextBox,
                                                    Path=IsKeyboardFocused}"
                                                          Value="True">
                                                    <Setter Property="Visibility"
                                                         Value="Collapsed"/>
                                                </DataTrigger>

                                                <!-- Hide hint when text is entered -->
                                                <DataTrigger Binding="{Binding ElementName=MessageTextBox,
                                                    Path=Text}"
                                                    Value="">
                                                    <Setter Property="Visibility"
                                                    Value="Visible"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>


                                <Button 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Command="{Binding SendMessageCommand}"
                                    IsEnabled="{Binding CanSendMessage}">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">

                                            <Border Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="0 0 10 0">

                                                <Image x:Name="Sendbtn"
                                                       Width="18"
                                                       Height="18"
                                                        Source="{svgc:SvgImage Source=/Assets/Images/SendButton.svg}">

                                                </Image>

                                            </Border>

                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>
                            </Grid>

                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>


        <ContentControl Content="{Binding CurrentView}"/>

    </Grid>
</Window>
