<UserControl x:Class="POC16_AICHATAPPLICATION_FIGMATOWPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Converters"
             xmlns:vm="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.ViewModels"
             xmlns:helpers="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Helpers"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             Background="White"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">



    <UserControl.Resources>

        <converters:BooleanToRequirementConverter
        x:Key="BooleanToRequirementConverter"/>

        <converters:BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>

        <converters:InverseBooleanToVisibilityConverter
        x:Key="InverseBooleanToVisibilityConverter"/>

        <converters:StringToVisibilityConverter
        x:Key="StringToVisibilityConverter"/>


        <!-- ===================================================== -->
        <!-- COLORS                                                -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#4820E8"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#181818"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#777777"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#E5E5E5"/>

        <SolidColorBrush x:Key="ErrorBrush"
                         Color="#D93025"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#188038"/>


        <!-- ===================================================== -->
        <!-- TEXTBOX                                               -->
        <!-- ===================================================== -->

        <Style x:Key="LoginTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#222222"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- PASSWORD BOX                                          -->
        <!-- ===================================================== -->

        <Style x:Key="LoginPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#222222"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type PasswordBox}">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- LOGIN BUTTON                                          -->
        <!-- ===================================================== -->

        <Style x:Key="LoginButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="47"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="LoginBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="LoginBorder"
                                        Property="Opacity"
                                        Value="0.90"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="LoginBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="LoginBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- GOOGLE BUTTON                                         -->
        <!-- ===================================================== -->

        <Style x:Key="GoogleButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="BorderBrush"
                    Value="#E3E3E3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="GoogleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="GoogleBorder"
                                        Property="Background"
                                        Value="#FAFAFA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- PAGE                                                      -->
    <!-- ========================================================= -->

    <Grid Background="#F7F7F8"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">


        <!-- Responsive host: provides a finite viewport at every DPI scale. -->
        <Grid Margin="20"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- ================================================= -->
            <!-- LOGIN CARD                                         -->
            <!-- ================================================= -->

            <Border MaxWidth="540"
                    MinWidth="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#EEEEEE"
                    BorderThickness="1"
                    Padding="40,20,40,30">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="24"
                        ShadowDepth="4"
                        Direction="270"
                        Opacity="0.10"/>

                </Border.Effect>


                <!-- ================================================= -->
                <!-- CARD CONTENT                                      -->
                <!-- ================================================= -->

                <ScrollViewer x:Name="LoginFormScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Focusable="False"
                      Padding="0,0,8,0"
                      PanningMode="VerticalOnly">


                    <StackPanel HorizontalAlignment="Stretch">


                        <!-- ========================================= -->
                        <!-- ROBOT LOGO                                -->
                        <!-- ========================================= -->

                        <Image Source="{svgc:SvgImage Source=/Assets/Images/Chatbot.svg}"
                               Width="80"
                               Height="80"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>


                        <!-- ========================================= -->
                        <!-- TITLE                                     -->
                        <!-- ========================================= -->

                        <TextBlock Text="Welcome back"
                                   HorizontalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,9"/>


                        <!-- ========================================= -->
                        <!-- SUBTITLE                                  -->
                        <!-- ========================================= -->

                        <TextBlock Text="Sign in to continue to ChatAI"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,31"/>


                        <!-- ========================================= -->
                        <!-- USER ID                                   -->
                        <!-- ========================================= -->

                        <TextBlock Text="User ID"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="Black"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="UserIdTextBox"
                                 Style="{StaticResource LoginTextBoxStyle}"
                                 Margin="0,0,0,24"
                                 Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- ========================================= -->
                        <!-- PASSWORD                                  -->
                        <!-- ========================================= -->

                        <TextBlock Text="Password"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="Black"
                                   Margin="0,0,0,8"/>


                        <!-- ========================================= -->
                        <!-- PASSWORD INPUT                            -->
                        <!-- ========================================= -->

                        <Grid x:Name="PasswordContainer"
                              Height="46"
                              Margin="0,0,0,6">


                            <!-- Masked -->

                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource LoginPasswordBoxStyle}"
                                         Padding="13,0,42,0"
                                        helpers:PasswordBoxHelper.BoundPassword="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        helpers:PasswordBoxHelper.Attach="True"
                                        Visibility="{Binding IsPasswordVisible,
                                        Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>


                            <!-- Visible -->

                            <TextBox x:Name="VisiblePasswordTextBox"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     Padding="13,0,42,0"
                                     Text="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding IsPasswordVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>



                            <!-- ===================================== -->
                            <!-- EYE BUTTON                            -->
                            <!-- ===================================== -->

                            <Button x:Name="PasswordVisibilityButton"
                                    Width="38"
                                    Height="38"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Command="{Binding TogglePasswordVisibilityCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent"
                                    BorderThickness="0">
                                            <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid Width="20"
                                      Height="20">

                                    <!-- Eye -->
                                    <Path x:Name="EyeIcon"
                                      Width="18"
                                      Height="18"
                                      Fill="#777777"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M10,3
                                            C5,3 1.5,6.2 0,10
                                            C1.5,13.8 5,17 10,17
                                            C15,17 18.5,13.8 20,10
                                            C18.5,6.2 15,3 10,3 Z
                                            M10,14
                                            C7.8,14 6,12.2 6,10
                                            C6,7.8 7.8,6 10,6
                                            C12.2,6 14,7.8 14,10
                                            C14,12.2 12.2,14 10,14 Z"/>


                                    <!-- Slash -->
                                    <Line x:Name="EyeSlash"
                                      X1="16"
                                      Y1="2"
                                      X2="2"
                                      Y2="16"
                                      Stroke="#777777"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                        <Line.Style>
                                            <Style TargetType="Line">

                                                <!-- Default: SHOW SLASH -->
                                                <Setter Property="Visibility"
                                            Value="Visible"/>

                                                <Style.Triggers>

                                                    <!-- Password is SHOWN -->
                                                    <!-- Remove slash -->
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}"
                                                  Value="True">

                                                        <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Line.Style>

                                    </Line>
                                </Grid>

                            </Button>

                        </Grid>


                        <!-- ========================================= -->
                        <!-- PASSWORD ERROR                            -->
                        <!-- ========================================= -->

                        <TextBlock x:Name="PasswordErrorText"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,8"
                                   Text="{Binding ErrorMessage}"
                                   Visibility="{Binding ErrorMessage,
                                    Converter={StaticResource StringToVisibilityConverter}}"/>


                        <!-- ========================================= -->
                        <!-- PASSWORD REQUIREMENTS                     -->
                        <!-- ========================================= -->

                        <StackPanel x:Name="PasswordRequirementsPanel"
                                    Margin="2,0,0,13"
                                    Visibility="{Binding HasPassword,
                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                            <TextBlock Text="Password must contain:"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="LengthRequirement"
                                       Text="{Binding IsPasswordLengthValid,
                                      Converter={StaticResource BooleanToRequirementConverter},
                                      ConverterParameter=At least 8 characters}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                            <TextBlock x:Name="UpperRequirement"
                                       Text="{Binding IsUppercaseValid,
                                      Converter={StaticResource BooleanToRequirementConverter},
                                      ConverterParameter=One uppercase letter (A-Z)}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                            <TextBlock x:Name="LowerRequirement"
                                        Text="{Binding IsLowercaseValid,
                                        Converter={StaticResource BooleanToRequirementConverter},
                                        ConverterParameter=One lowercase letter (a-z)}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                            <TextBlock x:Name="NumberRequirement"
                                       Text="{Binding IsNumberValid,
                                      Converter={StaticResource BooleanToRequirementConverter},
                                      ConverterParameter=One number (0-9)}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                            <TextBlock x:Name="SpecialRequirement"
                                        Text="{Binding IsSpecialCharacterValid,
                                          Converter={StaticResource BooleanToRequirementConverter},
                                          ConverterParameter=One special character (!@#$...)}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                            <TextBlock x:Name="WhitespaceRequirement"
                                       Text="{Binding IsNoWhitespaceValid,
                                      Converter={StaticResource BooleanToRequirementConverter},
                                      ConverterParameter=No spaces}"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,1"/>

                        </StackPanel>


                        <!-- ========================================= -->
                        <!-- LOGIN                                    -->
                        <!-- ========================================= -->

                        <Button x:Name="LoginButton"
                                Content="Login"
                                Style="{StaticResource LoginButtonStyle}"
                                Margin="0,0,0,17"
                                Command="{Binding LoginCommand}"/>


                        <!-- ========================================= -->
                        <!-- OR                                       -->
                        <!-- ========================================= -->

                        <Grid Height="20"
                              Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Grid.Column="0"
                                    Height="1"
                                    Background="#EEEEEE"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>


                            <TextBlock Grid.Column="1"
                                       Text="OR"
                                       FontSize="12"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"/>


                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="#EEEEEE"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ========================================= -->
                        <!-- GOOGLE                                   -->
                        <!-- ========================================= -->

                        <Button x:Name="GoogleLoginButton"
                                Style="{StaticResource GoogleButtonStyle}"
                                Command="{Binding GoogleLoginCommand}">

                            <StackPanel Orientation="Horizontal">

                                <!-- Google G -->

                                <Image Source="/Assets/Images/Google.png"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Continue with Google"
                                           FontSize="16"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>
                </ScrollViewer>


            </Border>

        </Grid>

    </Grid>
</UserControl>