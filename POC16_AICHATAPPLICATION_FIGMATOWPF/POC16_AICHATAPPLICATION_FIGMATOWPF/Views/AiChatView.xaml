<UserControl x:Class="POC16_AICHATAPPLICATION_FIGMATOWPF.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Views"
             xmlns:helpers="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Helpers"
             xmlns:converters="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Converters"
             xmlns:behaviors="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Behaviors"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="1022" 
             d:DesignWidth="1440"
             Background="{StaticResource SidebarBackground}">




    <UserControl.Resources>

        <converters:PlaceholderVisibilityConverter
     x:Key="PlaceholderVisibilityConverter"/>

        <converters:BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>



        <DataTemplate x:Key="AIMessageTemplate">

            <StackPanel HorizontalAlignment="Left"
                    Margin="10,8,16,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AI Profile -->
                    <Border Width="32"
                        Height="32"
                        CornerRadius="9999"
                        VerticalAlignment="Top">

                        <Image Source="{svgc:SvgImage Source=/Assets/Images/Aiprofile.svg}"
                           Width="24"
                           Height="24"/>
                    </Border>

                    <!-- AI Message -->
                    <StackPanel Grid.Column="2">

                        <Border Background="White"
                            CornerRadius="8"
                            Padding="14,12"
                            MaxWidth="724"
                            HorizontalAlignment="Left">


                            <!-- Message Bubble -->
                            <Border
                            Background="#FFFFFF"
                            CornerRadius="8"
                            Padding="10,12"
                            MaxWidth="724"
                            HorizontalAlignment="Left">    

                                <StackPanel>

                                    <!-- IMAGE PREVIEW -->
                                    <Border
                                    Width="260"
                                    Height="180"
                                    MaxHeight="180"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Visibility="{Binding IsImageAttachment,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <Image
                                          Source="{Binding AttachmentPath,
                                         TargetNullValue={x:Null},
                                         FallbackValue={x:Null}}"
                                        Width="260"
                                        Height="180"
                                        Stretch="UniformToFill"/>   

                                    </Border>


                                    <!-- FILE NAME -->
                                    <TextBlock
                                        Text="{Binding AttachmentName}"
                                        FontFamily="Inter"
                                        FontSize="12"
                                        Foreground="White"
                                        Margin="0,0,0,6"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasAttachment,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/> 


                                    <!-- AI MESSAGE -->
                                    <TextBlock
                                        Text="{Binding MessageText}"
                                        FontFamily="Inter"
                                        FontSize="{StaticResource ChatFontSize}"
                                        FontWeight="Normal"
                                        Foreground="#1F2937"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>
                        </Border>

                        <!-- Timestamp -->
                        <TextBlock
                        Text="{Binding Timestamp, StringFormat='{}{0:hh:mm tt}'}"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#A9AFB8"
                        Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </DataTemplate>



        <DataTemplate x:Key="UserMessageTemplate">

            <Grid
            HorizontalAlignment="Right"
            Margin="0,8,16,0">

                <Grid.ColumnDefinitions>
                    <!-- Message -->
                    <ColumnDefinition Width="*"/>

                    <!-- Space -->
                    <ColumnDefinition Width="10"/>

                    <!-- Profile -->
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>


                <!-- USER MESSAGE + TIMESTAMP -->

                <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Right">

                    <!-- Message Bubble -->
                    <Border
                    Background="#4F46E5"
                    CornerRadius="8"
                    Padding="16,12"
                    MaxWidth="724"
                    HorizontalAlignment="Right">


                        <StackPanel>

                            <!-- IMAGE PREVIEW -->
                            <Border
                            Width="260"
                            Height="180"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Visibility="{Binding IsImageAttachment,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Image
                                Source="{Binding AttachmentPath,
                                 TargetNullValue={x:Null},
                                 FallbackValue={x:Null}}"
                                Width="260"
                                Height="180"
                                Stretch="UniformToFill"/>

                            </Border>


                            <!-- FILE NAME -->
                            <TextBlock
                            Text="{Binding AttachmentName}"
                            FontFamily="Inter"
                            FontSize="12"
                            Foreground="White"
                            Margin="0,0,0,6"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasAttachment,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>


                            <TextBlock
                            Text="{Binding MessageText}"
                            FontFamily="Inter"
                            FontSize="{StaticResource ChatFontSize}"
                            FontWeight="Normal"
                            Foreground="White"
                            TextWrapping="Wrap"/>
                        </StackPanel>

                    </Border>


                    <!-- Timestamp -->
                    <TextBlock
                    Text="{Binding Timestamp,
                           StringFormat='{}{0:hh:mm tt}'}"
                    FontFamily="Inter"
                    FontSize="12"
                    Foreground="#A9AFB8"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0"/>

                </StackPanel>



                <!-- USER PROFILE -->


                <Border
                Grid.Column="2"
                Width="32"
                Height="32"
                CornerRadius="12"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,0,0,0">

                    <Image
                    Source="/Assets/Images/meet.png"
                    Width="24"
                    Height="24"
                    Stretch="Uniform"/>

                </Border>

            </Grid>

        </DataTemplate>


        <helpers:MessageTemplateSelector
    x:Name="MessageTemplateSelector"
    x:Key="MessageTemplateSelector"
    UserTemplate="{StaticResource UserMessageTemplate}"
    AITemplate="{StaticResource AIMessageTemplate}"/>



    </UserControl.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="350"
                              MinWidth="240"
                              MaxWidth="360"/>

            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <Border Grid.Column="0"
        Background="{StaticResource SidebarBackground}"
        BorderThickness="0 0 1 0"
        BorderBrush="{StaticResource BorderColor}">

            <Grid>




                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>



                <!-- 1. SIDEBAR HEADER -->


                <Border Grid.Row="0"
                Height="45"
                Margin="18,18"
                Padding="0 2 0 2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{StaticResource SidebarBackground}">

                    <Grid>

                        <Image x:Name="chatimg"
                           Source="{svgc:SvgImage Source=/Assets/Images/ChatAi.svg}"
                           Width="30"
                           Height="24"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                        <TextBlock x:Name="chattext"
                           Text="ChatAI"
                           Margin="38,5,0,0"
                           FontFamily="Inter"
                           FontWeight="Medium"
                           FontSize="20"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- 2. NEW CHAT BUTTON -->


                <Button x:Name="NewChatbtn"
                        Grid.Row="1"
                        Height="48"
                        Margin="16,0,16,8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="#4F46E5"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Command="{Binding NewChatCommand}"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">

                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>


                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image x:Name="Pluseicon"
                        Source="{svgc:SvgImage Source=/Assets/Images/Pluseicon.svg}"
                        Width="14"
                        Height="16"/>

                        <TextBlock Text="New Chat"
                           FontFamily="Inter"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="5,0,4,0"/>

                    </StackPanel>

                </Button>



                <!-- 3. CHAT HISTORY -->


                <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Margin="5,2,0,2">

                    <ItemsControl ItemsSource="{Binding Chats}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border
                                Margin="10,0,16,5"
                                Width="318"
                                Height="70">

                                    <Grid>


                                        <!-- MAIN CHAT BUTTON -->
                                        <!-- Click anywhere except three dots = Open Chat -->


                                        <Button
                                        Height="70"
                                        Padding="0"
                                        Background="{DynamicResource SidebarbtnBackground}"
                                        Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.OpenChatCommand,
                                            RelativeSource={
                                                RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">

                                            <Button.Template>

                                                <ControlTemplate TargetType="Button">

                                                    <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">

                                                        <Grid>

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="40"/>
                                                                <RowDefinition Height="25"/>
                                                            </Grid.RowDefinitions>



                                                            <!-- CHAT TITLE -->


                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="{Binding Title}"
                                                                FontFamily="Inter"
                                                                FontSize="16"
                                                                FontWeight="Medium"
                                                                Foreground="{StaticResource TextPrimary}"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                Margin="13,0,45,0"
                                                                TextTrimming="CharacterEllipsis"
                                                                behaviors:RenameCommitBehavior.Command="{Binding DataContext.FinishRenameCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                                                                <TextBlock.Style>

                                                                    <Style TargetType="TextBlock">

                                                                        <Setter
                                                                        Property="Visibility"
                                                                        Value="Visible"/>

                                                                        <Style.Triggers>

                                                                            <DataTrigger
                                                                                Binding="{Binding IsRenaming}"
                                                                                Value="True">

                                                                                <Setter
                                                                                Property="Visibility"
                                                                                Value="Collapsed"/>

                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </TextBlock.Style>

                                                            </TextBlock>



                                                            <!-- RENAME TEXTBOX -->


                                                            <TextBox
                                                                x:Name="RenameTextBox"
                                                                Grid.Row="0"
                                                                Height="32"
                                                                Margin="13,0,45,0"
                                                                Padding="8,0"
                                                                FontFamily="Inter"
                                                                FontSize="16"
                                                                Foreground="#374151"
                                                                Background="White"
                                                                BorderBrush="{StaticResource BorderColor}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Text="{Binding Title,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                                behaviors:RenameCommitBehavior.Command="{Binding DataContext.FinishRenameCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                                                                <TextBox.Style>

                                                                    <Style TargetType="TextBox">

                                                                        <Setter
                                                                        Property="Visibility"
                                                                        Value="Collapsed"/>

                                                                        <Style.Triggers>

                                                                            <DataTrigger
                                                                            Binding="{Binding IsRenaming}"
                                                                            Value="True">

                                                                                <Setter
                                                                            Property="Visibility"
                                                                            Value="Visible"/>

                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </TextBox.Style>

                                                            </TextBox>



                                                            <!-- TIME -->


                                                            <TextBlock
                                                            Grid.Row="1"
                                                            Text="{Binding TimeAgo}"
                                                            FontFamily="Inter"
                                                            FontWeight="Normal"
                                                            FontSize="12"
                                                            Foreground="{StaticResource TextPrimary}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="13,0,0,0"/>

                                                        </Grid>

                                                    </Border>

                                                </ControlTemplate>

                                            </Button.Template>

                                          


                                        </Button>



                                        <!-- THREE DOT BUTTON -->
                                        <!-- Completely separate from Main Chat Button -->


                                        <Button
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,5,7,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextPrimary}"
                                        FontSize="20"
                                        FontWeight="ExtraBlack"
                                        Content="⋯"
                                        Cursor="Hand"
                                        Panel.ZIndex="100"
                                        Tag="{Binding DataContext,
                                            RelativeSource={
                                                RelativeSource AncestorType=ItemsControl}}"
                                        behaviors:ContextMenuBehavior.OpenOnClick="True">


                                            <!-- REMOVE DEFAULT BUTTON STYLE -->


                                            <Button.Template>

                                                <ControlTemplate TargetType="Button">

                                                    <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                                </ControlTemplate>

                                            </Button.Template>



                                            <!-- CONTEXT MENU -->

                                            <Button.ContextMenu>

                                                <ContextMenu
                                                 Background="{StaticResource SidebarBackground}">


                                                    <!-- RENAME -->

                                                    <MenuItem
                                                Header="Rename"
                                                Foreground="{StaticResource TextPrimary}"
                                                Command="{Binding PlacementTarget.Tag.RenameChatCommand,
                                                    RelativeSource={
                                                        RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={
                                                        RelativeSource AncestorType=ContextMenu}}"/>



                                                    <!-- DELETE -->


                                                    <MenuItem
                                                    Header="Delete"
                                                    Foreground="{StaticResource TextPrimary}"
                                                    Command="{Binding PlacementTarget.Tag.DeleteChatCommand,
                                                        RelativeSource={
                                                            RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext,
                                                        RelativeSource={
                                                            RelativeSource AncestorType=ContextMenu}}"/>

                                                </ContextMenu>

                                            </Button.ContextMenu>

                                        </Button>

                                    </Grid>

                                </Border>

                            </DataTemplate>



                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>



                <!-- 4. PROFILE / BOTTOM AREA -->

                <Border Grid.Row="3"
                Height="50"
                Margin="14,0,14,8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="Transparent">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>


                        <!-- Profile -->
                        <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <Image x:Name="Profileimg"
                                   Width="32"
                                   Height="32"
                                   Source="{Binding CurrentUserProfilePicture, TargetNullValue={x:Null}, FallbackValue={x:Null}}"/>


                            <!-- <Image x:Name="ProfileUser"
                                   Width="32"
                                   Height="32"
                                   Source="/Assets/Images/meet.png"/>
                            -->


                            <TextBlock x:Name="Profiletext"
                               Text="{Binding CurrentUserName}"
                               FontFamily="Inter"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               Padding="12,0,0,0"/>


                            <!-- <TextBlock x:Name="Profiletextuser"
                                       Text="Meet"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Padding="12,0,0,0"/>  
                            -->

                        </StackPanel>


                        <!-- Settings / Exit -->
                        <StackPanel Grid.Column="1"
                            Width="60"
                            Height="23"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">


                            <Button x:Name="SettingButton" 
                                    Width="25" 
                                    Height="20" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    ToolTip="Settings"
                                    Foreground="{StaticResource TextPrimary}"
                                    Margin="0,0"
                                    Command="{Binding DataContext.SettingsCommand,
                  RelativeSource={RelativeSource AncestorType=Window}}">

                                <!-- Remove Default WPF Hover Effect -->
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>



                                <Image x:Name="Settingicon"
                                       Width="17"
                                       Height="17"
                                       Source="{svgc:SvgImage Source=/Assets/Images/Settings.svg}"
                                       />
                            </Button>
                        


                            <Button x:Name="ExitButton" 
                                    Width="28" 
                                    Height="20" 
                                    Background="Transparent" 
                                    Foreground="{StaticResource TextPrimary}"
                                    BorderThickness="0" 
                                    Cursor="Hand"
                                    ToolTip="Logout"
                                    Command="{Binding LogoutCommand}">
                                    <!-- Command="{Binding ExitCommand}" -->

                                <!-- Remove Default WPF Hover Effect -->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>



                                <Image x:Name="Exiticon"
                                       Width="17"
                                       Height="17"
                                       Source="{svgc:SvgImage Source=/Assets/Images/Logout.svg}"
                                       Margin="5,0"/>
                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Border>





        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>




            <Border Grid.Row="0"
                 BorderBrush="{StaticResource BorderColor}"
                 BorderThickness="0 0 0 1"
                 Background="{StaticResource SidebarBackground}"
                 behaviors:WindowDragBehavior.EnableDrag="True">


                <Grid>

                    <TextBlock Text="{Binding Title}"
                                MaxWidth="500"
                                Height="22"
                                FontSize="16"
                                FontFamily="Inter"
                                Margin="16 7 90 0"
                                FontWeight="Medium"
                                TextTrimming="CharacterEllipsis"
                                TextAlignment="Left"
                                Background="{StaticResource SidebarBackground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Foreground="{StaticResource TextPrimary}"/>


                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Panel.ZIndex="1000"
                            IsHitTestVisible="True">

                        <!-- Minimize -->
                        <Button Content="−"
                                Width="32"
                                Height="32"
                                FontSize="20"
                                Foreground="{StaticResource TextPrimary}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Focusable="False"
                                Panel.ZIndex="1001"
                                IsHitTestVisible="True"
                                Command="{Binding MinimizeWindowCommand}">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>


                        <!-- Close -->
                        <Button Content="×"
                                Width="32"
                                Height="32"
                                FontSize="20"
                                Foreground="{StaticResource TextPrimary}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Focusable="False"
                                Panel.ZIndex="1001"
                                IsHitTestVisible="True"
                                Command="{Binding CloseWindowCommand}">


                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">

                                        <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>


            <Border Grid.Row="1"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource BorderColor}"
            HorizontalAlignment="Stretch">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Messages -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:AutoScrollBehavior.AutoScroll="True">

                        <ItemsControl
                        ItemsSource="{Binding Messages}"
                        ItemTemplateSelector="{StaticResource MessageTemplateSelector}"/>

                    </ScrollViewer>


                    <Border
                    Grid.Row="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="360"
                     Margin="20"
                     Padding="30"
                     
                     CornerRadius="12">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Visibility"
                                Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger
                                     Binding="{Binding IsEmptyChat}"
                                     Value="True">

                                        <Setter
                                 Property="Visibility"
                                 Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel
                         HorizontalAlignment="Center">

                            <TextBlock
                             Text="Start a new conversation"
                             FontFamily="Inter"
                             FontSize="20"
                             TextWrapping="Wrap"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"
                             HorizontalAlignment="Center"/>

                            <TextBlock
                             Text="Send a message to start chatting with AI."
                             FontFamily="Inter"
                             TextWrapping="Wrap"
                             FontSize="16"
                             Foreground="{StaticResource TextPrimary}"
                             TextAlignment="Center"
                             Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>



                    <!-- AI Typing Indicator -->
                    <Border x:Name="AiTypingIndicator"
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="16,0,16,15"
                            Padding="12,8"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0"
                            CornerRadius="12"
                            Visibility="{Binding IsAiTyping,
                             Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel Orientation="Horizontal">

                            <!-- AI Profile -->
                            <!-- <Image Source="{svgc:SvgImage Source=/Assets/Images/Aiprofile.svg}"
                                   Width="22"
                                   Height="22"
                                   Margin="0,0,8,0"/>
                            -->

                            <TextBlock Text="AI is typing"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                            <TextBlock x:Name="TypingDots"
                                       Text="."
                                       FontFamily="Inter"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="3,0,0,0">

                                <TextBlock.Triggers>

                                    <EventTrigger RoutedEvent="Loaded">

                                        <BeginStoryboard>

                                            <Storyboard RepeatBehavior="Forever">

                                                <StringAnimationUsingKeyFrames
                                                Storyboard.TargetProperty="Text"
                                                Duration="0:0:1.2">

                                                    <DiscreteStringKeyFrame
                                                    Value="."
                                                    KeyTime="0:0:0"/>

                                                    <DiscreteStringKeyFrame
                                                    Value=".."
                                                    KeyTime="0:0:0.4"/>

                                                    <DiscreteStringKeyFrame
                                                    Value="..."
                                                    KeyTime="0:0:0.8"/>

                                                    <DiscreteStringKeyFrame
                                                    Value="."
                                                    KeyTime="0:0:1.2"/>

                                                </StringAnimationUsingKeyFrames>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                </TextBlock.Triggers>
                            </TextBlock>

                        </StackPanel>

                    </Border>


                    <Border
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Margin="16,4,16,12"
                    Padding="12"
                    MaxWidth="500"
                    BorderThickness="0,1,0,0"
                    CornerRadius="10">

                        <Border.Style>

                            <Style TargetType="Border">

                                <!-- Hidden normally -->

                                <Setter
                        Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <!-- Show only when an error exists -->

                                    <DataTrigger
                            Binding="{Binding HasError}"
                            Value="True">

                                        <Setter
                                Property="Visibility"
                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>


                        <StackPanel>

                            <!-- Error Message -->

                            <TextBlock
                            Text="{Binding ErrorMessage}"
                            FontFamily="Inter"
                            FontSize="14"
                            Foreground="#B42318"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"/>


                            <!-- Retry Button -->

                            <Button
                            Content="Retry"
                            Command="{Binding RetryCommand}"
                            Width="80"
                            Height="32"
                            HorizontalAlignment="Left"
                            Background="#4F46E5"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                        </StackPanel>
                    </Border>
          


                    <!-- ATTACHMENT COMPOSER -->


                    <Border
                    MinWidth="120"
                    MaxWidth="300"
                    Height="50"
                    Margin="10"
                    Padding="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Panel.ZIndex="1000"
                    Visibility="{Binding HasAttachment,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <!-- FILE ICON -->

                            <Border
                            Width="42"
                            Height="42"
                            Background="{StaticResource SidebarBackground}"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                                <TextBlock
                                Text="📄"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TextPrimary}"
                                VerticalAlignment="Center" />    

                            </Border>


                            <!-- FILE INFORMATION -->

                            <StackPanel
                            Grid.Column="1"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center">

                                <TextBlock
                                Text="{Binding AttachedFileName}"
                                FontFamily="Inter"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimary}"
                                TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                Text="{Binding AttachedFileSize}"
                                FontFamily="Inter"
                                FontSize="11"
                                Foreground="{StaticResource TextPrimary}"
                                Margin="0,3,0,0"/>  

                            </StackPanel>


                            <!-- CLOSE / REMOVE -->

                            <Button
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Content="×"
                            FontSize="18"
                            Foreground="{StaticResource TextPrimary}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Remove attachment"
                            Command="{Binding RemoveAttachmentCommand}">    

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border
                        Background="Transparent"
                        BorderBrush="Transparent">

                                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>

                    </Border>
                </Grid>
            </Border>



            <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                HorizontalAlignment="Stretch"
                Padding="85,0,85,0">



                <Grid>

                    <Grid.ColumnDefinitions>
                        <!-- Attach + Mic -->
                        <ColumnDefinition Width="55"/>

                        <!-- Message -->
                        <ColumnDefinition Width="*"/>

                        <!-- Send -->
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>


                    <!-- Attach + Mic -->
                    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            >



                        <Button x:Name="AttachButton"
                                Width="30"
                                Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimary}"
                                Padding="0 0 10 0"
                                Cursor="Hand"
                                ToolTip="Attach File"
                                Command="{Binding AttachFileCommand}">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                        <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <Image Width="14"
                               Height="16"
                               Source="{svgc:SvgImage Source=/Assets/Images/AttechFile.svg}"
                               Stretch="Uniform"/>


                        </Button>





                        <Button x:Name="MicButton"
                                Width="21"
                                Height="22"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                Foreground="{StaticResource TextPrimary}"
                                BorderThickness="0"
                                ToolTip="Microphone"
                                Cursor="Hand"
                                Command="{Binding StartVoiceCommand}">
                                


                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0">
                                        <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>        
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>



                            <Grid Width="20"
                                    Height="20">

                                <!-- Normal microphone -->
                                <Image x:Name="NormalMicImage"
                                        Source="{svgc:SvgImage Source=/Assets/Images/Mic.svg}"
                                       Width="12"
                                       Height="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                    <Image.Style>
                                        <Style TargetType="Image">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsListening}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </Image.Style>
                                </Image>



                                <!-- Listening microphone -->
                                
                                <TextBlock Text="●"
                                   FontSize="26"
                                   Foreground="Red"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsListening}"
                                                Value="True">

                                                    <Setter Property="Visibility"
                                                Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>

                    </StackPanel>




                    <Border Grid.Column="1"
                            Height="43"
                            BorderBrush="{StaticResource BorderColor}"
                            Background="{StaticResource SidebarBackground}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            MaxWidth="920"> 
                        
                        <Grid>

                            <TextBox x:Name="MessageTextBoxChat"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Inter"
                                     FontSize="16"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="Transparent"
                                     MaxHeight="120"
                                     FontWeight="Normal"
                                     CaretBrush="{StaticResource TextPrimary}"
                                     Padding="22,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     behaviors:EnterToSendBehavior.Command="{Binding SendMessageCommand}"/>

                            <TextBlock Text="Message ChatAI..."
                                       Margin="30,0,55,0"
                                       Padding="2 0"
                                       FontSize="17"
                                       FontFamily="Inter"
                                       FontWeight="Normal"
                                       Foreground="#A9AFBD"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                            Value="Visible"/>

                                        <Style.Triggers>

                                            <!-- Hide hint when TextBox gets focus -->
                                            <DataTrigger Binding="{Binding ElementName=MessageTextBoxChat,
                                            Path=IsKeyboardFocused}"
                                                  Value="True">
                                                <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide hint when text is entered -->
                                            <DataTrigger Binding="{Binding ElementName=MessageTextBoxChat,
                                            Path=Text}"
                                            Value="">
                                                <Setter Property="Visibility"
                                                 Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                        </Grid>


                    </Border>



                    <!-- Send Button -->

                    <Border x:Name="SendbtnBorder"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            Background="#4F46E5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="8">

                        <Button x:Name="SendChat"
                            Command="{Binding SendMessageCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            Padding="8,0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border
                                    x:Name="SendButtonBorder"
                                    Background="#4F46E5"
                                    CornerRadius="8">

                                        <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- Request is running -->
                                        <Trigger Property="IsEnabled"
                                        Value="False">

                                            <Setter
                                        TargetName="SendButtonBorder"
                                        Property="Opacity"
                                        Value="8"/>

                                            <Setter
                                        TargetName="SendButtonBorder"
                                        Property="Background"
                                        Value="#9CA3AF"/>

                                        </Trigger>

                                        <!-- Request is finished -->
                                        <Trigger Property="IsEnabled"
                                         Value="True">

                                            <Setter
                                        TargetName="SendButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>

                                            <Setter
                                        TargetName="SendButtonBorder"
                                        Property="Background"
                                        Value="#4F46E5"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Button.Template>

                            <Image x:Name="Sendbtn"
                                Width="18"
                                Height="18"
                                Source="{svgc:SvgImage Source=/Assets/Images/AiSend.svg}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Button>

                    </Border>

                </Grid>
            </Border>
        </Grid>


     
    </Grid>

</UserControl>
