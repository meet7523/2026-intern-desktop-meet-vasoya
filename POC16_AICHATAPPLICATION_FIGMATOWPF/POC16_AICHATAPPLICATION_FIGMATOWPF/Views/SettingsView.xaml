<UserControl x:Class="POC16_AICHATAPPLICATION_FIGMATOWPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.ViewModels"
             xmlns:Converters="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Converters"
             xmlns:behaviors="clr-namespace:POC16_AICHATAPPLICATION_FIGMATOWPF.Behaviors"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="White">

  

    <UserControl.Resources>

        <Converters:EnumToBooleanConverter
        x:Key="EnumToBooleanConverter"/>



        <!-- =========================
             CARD STYLE
             ========================= -->

        <Style x:Key="SettingsCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

        </Style>


       

        <!-- =========================
             CLOSE BUTTON
             ========================= -->

       

        <Style x:Key="CloseButtonStyle"
       TargetType="{x:Type Button}">

            <Setter Property="Width"
            Value="33"/>

            <Setter Property="Height"
            Value="33"/>

            <Setter Property="Padding"
            Value="0"/>

            <Setter Property="Background"
            Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
            Value="#DDE2E2"/>

            <Setter Property="BorderThickness"
            Value="2"/>

            <Setter Property="Foreground"
            Value="#263234"/>

            <Setter Property="FontFamily"
            Value="Segoe UI"/>

            <Setter Property="FontSize"
            Value="18"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18"
                    SnapsToDevicePixels="True">

                            <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}"
                        RecognizesAccessKey="True">

                                <ContentPresenter.RenderTransform>
                                    <!-- Visually center the × glyph -->
                                    <TranslateTransform Y="-1"/>
                                </ContentPresenter.RenderTransform>

                            </ContentPresenter>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
       


        <!-- =========================
             TOGGLE SWITCH
             ========================= -->

        <Style x:Key="ToggleSwitchStyle"
               TargetType="CheckBox">

            <Setter Property="Width"
                    Value="40"/>

            <Setter Property="Height"
                    Value="22"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid>

                            <!-- Track -->

                            <Border x:Name="Track"
                                    Width="40"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ToggleOff}"
                                    BorderBrush="{StaticResource ToggleBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <Ellipse x:Name="Thumb"
                                         Width="12"
                                         Height="12"
                                         Fill="{DynamicResource ToggleThumbDisabledBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{StaticResource PrimaryTeal}"/>

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryTeal}"/>

                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="White"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,3,0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="LargeThemeRadioButton"
       TargetType="RadioButton">

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="Foreground"
            Value="{StaticResource TextPrimary}"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="RadioCircle"
                            Width="20"
                            Height="20"
                            CornerRadius="10"
                            BorderThickness="2"
                            BorderBrush="#8D9293"
                            Background="White"
                            VerticalAlignment="Center">

                                <Ellipse x:Name="RadioDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{StaticResource PrimaryTeal}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                             Value="True">

                                <Setter TargetName="RadioCircle"
                                Property="BorderBrush"
                                Value="{StaticResource PrimaryTeal}"/>

                                <Setter TargetName="RadioDot"
                                Property="Visibility"
                                Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="RadioCircle"
                                Property="BorderBrush"
                                Value="{StaticResource PrimaryTeal}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- =========================================================
         SETTINGS BACKGROUND
         ========================================================= -->

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Settings Window -->

        <Border 
                Background="{StaticResource WindowBackground}"
                behaviors:WindowDragBehavior.EnableDrag="True">

            <Grid Margin="28,20,28,18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="38"/>

                    <RowDefinition Height="73"/>

                    <RowDefinition Height="25"/>

                    <RowDefinition Height="68"/>

                    <RowDefinition Height="68"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="30"/>

                </Grid.RowDefinitions>


                <!-- =================================================
                     HEADER
                     ================================================= -->

                <Grid Grid.Row="0">

                    <TextBlock Text="Settings"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Top"/>

                    <Button Content="×"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand"
                    Command="{Binding CloseSettingsCommand}"/>

                </Grid>




                <!-- =================================================
     THEME CARD
     ================================================= -->

                <Border Grid.Row="1"
        Style="{StaticResource SettingsCard}"
        Margin="0,2,0,0">

                    <Grid Margin="12,8,12,8">

                        <Grid.ColumnDefinitions>

                            <!-- Theme Icon -->
                            <ColumnDefinition Width="32"/>

                            <!-- Theme Information -->
                            <ColumnDefinition Width="*"/>

                            <!-- Theme Selection -->
                            <ColumnDefinition Width="145"/>

                        </Grid.ColumnDefinitions>


                        <!-- Theme Icon -->

                        <TextBlock Grid.Column="0"
                                   Text="◐"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTeal}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>


                        <!-- Theme Text -->

                        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

                            <TextBlock Text="Theme"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>

                            <TextBlock Text="Choose between light and dark appearance"
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondary}"/>    

                        </StackPanel>


                        <!-- Theme Selection -->

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <!-- Light -->

                            <RadioButton x:Name="LightThemeRadio"
                                         Content="Light"
                                         GroupName="Theme"
                                         IsChecked="{Binding SelectedTheme,
                                         Converter={StaticResource EnumToBooleanConverter},
                                         ConverterParameter=Light}"
                                         FontSize="16"
                                         Foreground="{StaticResource TextPrimary}"
                                         VerticalAlignment="Center"
                                         Cursor="Hand"
                                         Style="{StaticResource LargeThemeRadioButton}"
                                         Margin="0,0,12,0"/>


                            <!-- Dark -->

                            <RadioButton x:Name="DarkThemeRadio"
                             Content="Dark"
                             GroupName="Theme"
                             FontSize="16"
                             IsChecked="{Binding SelectedTheme,
                                 Converter={StaticResource EnumToBooleanConverter},
                                 ConverterParameter=Dark}"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalAlignment="Center"
                             Style="{StaticResource LargeThemeRadioButton}"
                             Cursor="Hand"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- =================================================
                     PREFERENCES TITLE
                     ================================================= -->

                <TextBlock Grid.Row="2"
                           Text="PREFERENCES"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#6F787A"
                           VerticalAlignment="Center"
                           Margin="0,2,0,0"/>


                <!-- =================================================
                     PREFERENCE CARDS
                     ================================================= -->

                <Grid Grid.Row="3"
                      Margin="0,0,0,5">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="10"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- AUTO LAUNCH -->

                    <Border Grid.Column="0"
                            Style="{StaticResource SettingsCard}">

                        <Grid Margin="12,8,12,7">

                            <TextBlock Text="Auto Launch"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Top"/>

                            <CheckBox IsChecked="{Binding IsAutoLaunchEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"/>

                            <TextBlock Text="Launch app automatically when your PC starts"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,0"/>

                        </Grid>

                    </Border>


                    <!-- NOTIFICATIONS -->

                    <Border Grid.Column="2"
                            Style="{StaticResource SettingsCard}">

                        <Grid Margin="12,8,12,7">

                            <TextBlock Text="Notifications"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Top"/>

                            <CheckBox IsChecked="{Binding IsNotificationEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"/>

                            <TextBlock Text="Quick alerts. Instant awareness"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Bottom"/>

                        </Grid>

                    </Border>

                </Grid>


                <!-- =================================================
                     Font Size
                     ================================================= -->

                

                <Border Grid.Row="4"
                        Style="{StaticResource SettingsCard}"
                        Margin="0,0,0,4">

                    <Grid Margin="12,8,12,7">

                        <Grid.ColumnDefinitions>

                            <!-- Font Icon -->
                            <ColumnDefinition Width="32"/>

                            <!-- Font Information -->
                            <ColumnDefinition Width="*"/>

                            <!-- Font Size Selection -->
                            <ColumnDefinition Width="250"/>

                        </Grid.ColumnDefinitions>


                        <!-- Font Icon -->

                        <TextBlock Grid.Column="0"
                                   Text="A"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTeal}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>


                        <!-- Font Size Text -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Font Size"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>

                            <TextBlock Text="Choose the text size for the application"
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondary}"/>    

                        </StackPanel>


                        <!-- Font Size Selection -->

                        <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                            <!-- Small -->

                            <RadioButton Content="Small"
                                         GroupName="FontSize"
                                         IsChecked="{Binding SelectedFontSize,
                                         Converter={StaticResource EnumToBooleanConverter},
                                         ConverterParameter=Small}"
                                         Style="{StaticResource LargeThemeRadioButton}"
                                         FontSize="16"
                                         Margin="0,0,8,0"/>


                            <!-- Medium -->

                            <RadioButton Content="Medium"
                                         GroupName="FontSize"
                                         Style="{StaticResource LargeThemeRadioButton}"
                                         FontSize="16"
                                         IsChecked="{Binding SelectedFontSize,
                                         Converter={StaticResource EnumToBooleanConverter},
                                         ConverterParameter=Medium}"
                                         Margin="0,0,8,0"/>


                            <!-- Large -->

                            <RadioButton Content="Large"
                                         GroupName="FontSize"
                                         IsChecked="{Binding SelectedFontSize,
                                         Converter={StaticResource EnumToBooleanConverter},
                                         ConverterParameter=Large}"
                                         Style="{StaticResource LargeThemeRadioButton}"
                                         FontSize="16"/>

                        </StackPanel>

                    </Grid>

                </Border>
               



                <!-- =================================================
                     FOOTER
                     ================================================= -->

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">

                    <TextBlock Text="End User License Agreement"
                                FontSize="13"
                                FontWeight="Normal"
                               Foreground="#70797A"
                               Cursor="Hand"/>

                    <TextBlock Text="•"
                               Margin="12,0"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#858B8C"/>

                    <TextBlock Text="Privacy Policy"
                                FontSize="13"
                                FontWeight="Normal"
                                Foreground="#70797A"
                               Cursor="Hand"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</UserControl>

