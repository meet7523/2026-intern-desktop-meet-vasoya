
    <Window x:Class="POC_11_MVVM_ConuterApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC_11_MVVM_ConuterApplication"
        mc:Ignorable="d"
        Title="MVVM Counter Application" Height="500" Width="500" WindowStartupLocation="CenterScreen">

    <Grid Margin="20" x:Name="firstGrid">


        <StackPanel  HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Orientation="Vertical" Height="300" Width="400">

            <TextBlock x:Name="App"
                         Text="MVVM Counter Application"
                         HorizontalAlignment="Center"
                         FontSize="16"
                         FontWeight="Medium"/>
            
            <TextBlock Text="Counter"
                       FontSize="16"
                       Margin="30"
                       FontWeight="Medium" 
                       Height="25" Width="65"/>
            
            <TextBlock Text="{Binding Count}"
                       FontSize="16" 
                       Width="36"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="20">

                <Button Content="Increment"
                        Width="100"
                        FontSize="15"
                        Margin="5"
                        Command="{Binding IncrementCommand}"/>

                <Button Content="Decrement"
                        Width="100"
                        FontSize="15"
                        Margin="5"
                        Command="{Binding DecrementCommand}"/>

                <Button Content="Reset"
                        Width="100"
                        FontSize="15"
                        Margin="5"
                        Command="{Binding ResetCommand}"/>

            </StackPanel>

        </StackPanel>


    </Grid>
</Window>
