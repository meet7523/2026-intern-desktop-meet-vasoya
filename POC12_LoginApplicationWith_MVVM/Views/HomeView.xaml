<Window x:Class="POC12_LoginApplicationWith_MVVM.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC12_LoginApplicationWith_MVVM.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="HomeView" Height="750" Width="1200">
    <Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            <TextBlock x:Name="App"
                       Text="Welcome ,"
                       FontSize="20"
                       FontWeight="Medium"/>

            <TextBlock Name="uname"
                       Text="{Binding Username}"
                       FontSize="20"
                       FontWeight="Medium"/>


        </StackPanel>

    </Grid>
</Window>
