<Window x:Class="POC08_WPF_BASIC_FORM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC08_WPF_BASIC_FORM"
        mc:Ignorable="d"
        Title="MainWindow" Height="452" Width="800">
    <Grid HorizontalAlignment="Center" Margin="0,20,0,19" Width="575">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width ="250"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="1"
                Grid.Column="0"
                Content="First Name:"
                FontSize="21"/>

            <TextBox Grid.Row="1"
                Grid.Column="1"
                x:Name="txtfname"
                FontSize="21"
                Margin="5"/>

            <Label Grid.Row ="2"
                Grid.Column="0"
                Content="Last Name:"
                FontSize="21"/>

            <TextBox Grid.Row="2"
                Grid.Column="1"
                x:Name="txtlname"
                FontSize="21"
                Margin="5"/>

            <Label Grid.Row="3"
                Grid.Column="0"
                Content="Email:"
                FontSize="21"/>

            <TextBox Grid.Row="3"
                Grid.Column="1"
                x:Name="txtemail"
                FontSize="21"
                Margin="5"/>

            <Label Grid.Row="4"
                Grid.Column="0"
                Content="Phone No:"
                FontSize="21"/>

            <TextBox Grid.Row="4"
                Grid.Column="1"
                x:Name="txtphone"
                FontSize="21"
                Margin="5"/>

            <Label Grid.Row="5"
                Grid.Column="0"
                Content="Address:"
                FontSize="21"/>

            <TextBox Grid.Row="5"
                    Grid.Column="1"
                    x:Name="txtAddress"
                    Height="60"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontSize="21"
                    Margin="5"/>


            <Button Grid.Row="6"
                    Grid.Column="0"
                    x:Name="btnsubmit"
                    Content="Submit"
                    FontSize="21"
                    Margin="7" 
                    Click="btnsubmit_Click">
            </Button>

            <Button Grid.Row="6"
                    Grid.Column="1"
                    x:Name="btnclear"
                    Content="Clear"
                    FontSize="21"
                    Margin="7" 
                    Click="btnclear_Click">
            </Button>

        </Grid>
    </Grid>
</Window>
